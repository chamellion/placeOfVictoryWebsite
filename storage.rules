rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to carousel images
    match /carousel/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow public read access to testimonies photos
    match /testimonies/{allPaths=**} {
      allow read: if true;
      allow write: if true; // Allow public uploads for testimonies
    }
    
    // Default rule - deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
} 